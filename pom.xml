                <version>5.1.0</version>
            </dependency>
            <dependency>
                <groupId>TOUCHFound-VMS</groupId>
                <artifactId>vms-orm</artifactId>
                <version>5.1.0</version>
            </dependency>
            <dependency>
                <groupId>TOUCHFound-VMS</groupId>
                <artifactId>vms-service</artifactId>
                <version>5.1.0</version>
            </dependency>
            <!--<dependency>-->
                <!--<groupId>TOUCHFound-VMS</groupId>-->
                <!--<artifactId>vms-pay</artifactId>-->
                <!--<version>5.0.0</version>-->
            <!--</dependency>-->
            <dependency>
                <groupId>TOUCHFound-VMS</groupId>
                <artifactId>vms-commons</artifactId>
                <version>5.1.0</version>
            </dependency>
            <dependency>
                <groupId>TOUCHFound-VMS</groupId>
                <artifactId>vms-mq</artifactId>
                <version>5.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

