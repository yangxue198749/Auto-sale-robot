# setting.properties 模板
# 复制为 setting.properties（Git 忽略真实文件，不入库）并填入实际密码。
# 环境差异（存储根目录等）通过 JVM -D 覆盖，见 deploy/server/DEPLOY_RUNBOOK.md。

#====erp Settings====
#ERP 正式
erp_suffix=production
#ERP 测试
#erp_suffix=test


# 图片 URL 前缀：同源相对路径，任何域名/端口下都正确
imgUrlPrefix=/vmsimgs/
uploadImgFileUrl=/vmsimgs/

#====本地文件存储（替代已停用的阿里云 OSS）====
# 存储根目录由 JVM 系统属性 -Dlocal.storage.root 指定（开发=Windows 路径，服务器=Linux 路径）
local.storage.urlPrefix=/vmsimgs/

#====weChat Settings====
#魔核 测试环境
weChat_suffix=net
#魔核 正式环境
#weChat_suffix=com

#====安全配置====
# 是否允许验证码日期绕过（仅开发/测试环境启用，生产环境必须设为 false）
login.captcha.date.bypass.enabled=false  # 生产必须 false

#====Cayenne Settings (本地 MySQL 开发环境)====
cayenne.dbcp.driverClassName=com.mysql.cj.jdbc.Driver
cayenne.dbcp.url=jdbc:mysql://localhost:3306/vms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
cayenne.dbcp.username=root
cayenne.dbcp.password=<MYSQL_PASSWORD>

cayenne.dbcp.minIdle=5
cayenne.dbcp.maxActive=10
cayenne.dbcp.maxWait=3000

#====访问地址====
#====本机====
login_url=127.0.0.1
#====测试====
#login_url=touchfound.net
#====正式====
#login_url=touchfound.com


#=================================mq start====================
# 本地 RabbitMQ 开发环境
mq_host = 127.0.0.1
mq_port=5672
mq_user_name = <RABBITMQ_USER>
mq_pass_word = <RABBITMQ_PASSWORD>
pool_size=100
adms_pool_size=5


#交换机
responseExchangeName=open-api
payExchangeName=pay-service
#出货结果   即售
outResultImmediateQueueName=queue.outResult.immediate.vms.v1
outResultImmediateRequestTopic=mcs.report.outResult.immediate
outResultImmediateResponseTopic=sl.order.report

#出货结果   预售
outResultReserveQueueName=queue.outResult.reserve.vms.v1
outResultReserveRequestTopic=mcs.report.outResult.reserve


#出货结果   刷卡
outResultCardQueueName=queue.outResult.card.vms.v1
outResultCardRequestTopic=mcs.report.outResult.card

#商品
skuCfgReqQueueName=queue.skuCfgReq.v1
skuCfgReqRequestTopic=mcs.report.skuCfgReq

#闪购键
spCfgReqQueueName=queue.spCfgReq.v1
spCfgReqRequestTopic=mcs.report.spCfgReq

#走马灯
repeatTextReqQueueName=queue.repeatTextReq.v1
repeatTextReqRequestTopic=mcs.report.repeatTextReq

#节能
mtEnergyReqQueueName=queue.mtEnergyReq.v1
mtEnergyReqRequestTopic=mcs.report.mtEnergyReq

#开门密码
openDoorPwdReqQueueName=queue.openDoorPwdReq.v1
openDoorPwdReqRequestTopic=mcs.report.openDoorPwdReq

#售货机状态
vmStatusQueueName=queue.vmStatus.v1
vmStatusRequestTopic=mcs.report.vmStatus

#sim卡
simCodeQueueName=queue.simCode.v1
simCodeRequestTopic=mcs.report.simCode

#门锁
doorStatusQueueName=queue.doorStatus.v1
doorStatusRequestTopic=mcs.report.doorStatus

#货道
channelPolicyQueueName=queue.channelPolicy.v1
channelPolicyRequestTopic=mcs.report.channelPolicy

#售货机版本信息
vmDeviceInfoQueueName=queue.vmDeviceInfo.v1
vmDeviceInfoRequestTopic=mcs.report.vmDeviceInfo

#售货机版本信息
vmBaseInfoQueueName=queue.vmBaseInfo.v1
vmBaseInfoRequestTopic=mcs.report.vmBaseInfo

#area
areaQueueName=queue.areaRequest.v1
areaRequestTopic=request.area.v1
areaResponseTopic=response.area.v1

#bCustomer
bCustomerQueueName=queue.bCustomer.v1
bCustomerRequestTopic=request.bCustomer.v1
bCustomerResponseTopic=response.bCustomer.v1

#REFUND
refundTopic=order.pay.refund
bkRefundTopic=order.bk.refund
pmRefundTopic=order.pm.refund

#DELIVERED
deliveredTopic=task.delivery

#promotionOutResult
promotionOutResultQueueName=queue.promotionOutResult.vms.v1
promotionOutResultRequestTopic=mcs.report.outResult.promotion

#维修工单
repairWorkQueueName=queue.repairWork.vms.v1
repairWorkRequestTopic=request.repairWork.v1

#即售退款主题
immediateRefundTopic=topic.pay.refund.launch
#预订退款主题
reserveRefundTopic=topic.pay.refund.launch

#货架信息
skuOrderPolicyQueueName=queue.skuOrderPolicy.v1
skuOrderPolicyRequestTopic=mcs.report.skuOrderPolicy

#导出报表
exportResultQueueName=queue.result.export.v1
exportRequestTopic=request.export.v1
exportResponseTopic=response.export.v1

#节能(一拖多)
mtEnergyReqQueueNameNew=queue.mtEnergyReqNew.v1
mtEnergyComboReqTopic=mcs.report.mtEnergyComboReq

#快捷入口
mtPortalCfgReqQueueName=queue.mtPortalCfgReq.v1
mtPortalCfgReqTopic=mcs.report.portalCfgReq

#商品信息5.0.0a
skuInfoReqQueueName=queue.skuInfoReq.v1
skuInfoReqTopic=mcs.report.skuInfoReq

#预定（取货）截止时间
reserveEndTime=22
#=================================mq end====================
