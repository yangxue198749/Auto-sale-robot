#====支付功能 Settings====
#支付功能 正式环境
#pay_mobile_suffix=com
#支付功能 测试环境
pay_mobile_suffix=net

#====文件存储（原阿里云 OSS 已停用，改为本地磁盘）====
# 存储根目录必须使用无中文、无空格的路径，避免 properties 编码错乱
local.storage.root=D:/vms-data
local.storage.urlPrefix=http://127.0.0.1:8080/vmsimgs/
# 图片访问 URL 前缀，本地模式指向应用静态资源映射
imgUrlPrefix=http://127.0.0.1:8080/vmsimgs/
uploadImgFileUrl=/vmsimgs/
# 历史 AK 配置已废弃，保留仅作参考
# aliyun.oss.accessKeyId=<YOUR_ALIYUN_ACCESS_KEY_ID>
# aliyun.oss.accessKeySecret=<YOUR_ALIYUN_ACCESS_KEY_SECRET>

#====Cayenne Settings====
cayenne.dbcp.driverClassName=oracle.jdbc.driver.OracleDriver
cayenne.dbcp.url=jdbc:oracle:thin:@//<ORACLE_HOST>:1521/<DB_NAME>
cayenne.dbcp.username=<ORACLE_USER>
cayenne.dbcp.password=<ORACLE_PASSWORD>

cayenne.dbcp.minIdle=5
cayenne.dbcp.maxActive=10
cayenne.dbcp.maxWait=3000

#====访问地址====
#====本机====
login_url=127.0.0.1
#====测试====
#login_url=touchfound.net
#====正式====
#login_url=touchfound.com



#=================================mq start====================
#mq_host = 60.205.220.93
mq_host = <RABBITMQ_HOST>
mq_port=5672
mq_user_name = <RABBITMQ_USER>
mq_pass_word = <RABBITMQ_PASSWORD>
pool_size=100
adms_pool_size=5


#交换机
responseExchangeName=open-api
payExchangeName=pay-service
#出货结果   即售
outResultImmediateQueueName=queue.outResult.immediate.vms.v1
outResultImmediateRequestTopic=mcs.report.outResult.immediate
outResultImmediateResponseTopic=sl.order.report

#出货结果   预售
outResultReserveQueueName=queue.outResult.reserve.vms.v1
